{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome (index.html file)",
            "type": "pwa-chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Chrome (http://localhost:8000)",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start Python Server"
        },
        {
            "name": "Attach to Chrome (9222)",
            "type": "pwa-chrome",
            "request": "attach",
            "port": 9222,
            "webRoot": "${workspaceFolder}"
        }
    ]
}